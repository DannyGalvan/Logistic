# Configuracion del entorno StockFlow (plantilla).
# Copie a .env y reemplace los valores. .env esta en .gitignore.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
# Genere una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Base de datos Postgres remoto (este proyecto se conecta a un server academico).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
TEST_DATABASE_NAME=test_logistic
DB_CONN_MAX_AGE=60

# Localizacion
TIME_ZONE=America/Guatemala
LANGUAGE_CODE=es

# Pylint
PYLINT_TARGETS=apps,config
PYLINT_FAIL_UNDER=9.5
PYLINT_TIMEOUT=180
PYLINT_SNIPPET_MAX_BYTES=20000

# Inventario
EXPIRY_ALERT_DAYS=30

# Contrasena de los usuarios demo generados por seed_demo.
# Cambie este valor en cualquier despliegue real.
SEED_DEMO_PASSWORD=Cambia-en-produccion-1234

# Produccion (config.settings.prod). docker-compose los pone en 0 para probar en http://localhost.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# Tests: "postgres" hace que pytest use DATABASE_URL (por defecto SQLite en memoria).
# TEST_DATABASE_ENGINE=postgres

# Nota: Docker Compose interpreta "$" en este archivo; escapelo como "$$".
